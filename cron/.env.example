# PostgreSQL used by both the scraper and the Next.js app.
DATABASE_URL=postgresql://user:password@host:5432/database
BRIGHTDATA_API_KEY=replace-me

# Railway MinIO S3 API endpoint, credentials, and existing bucket.
# Use the internal service URL for MINIO_ENDPOINT_URL when both services run on Railway.
MINIO_ENDPOINT_URL=http://minio.railway.internal:9000
MINIO_ACCESS_KEY=replace-me
MINIO_SECRET_KEY=replace-me
MINIO_BUCKET=sale-images

# Public object URL prefix for the bucket root, not the MinIO console URL.
# The browser may access this URL only if the bucket has public read access;
# the planned Next.js API proxy can read a private bucket through S3 instead.
MINIO_PUBLIC_BASE_URL=https://images.example.com/sale-images

# Exact image hosts seen in scraped product URLs, separated by commas.
IMAGE_ALLOWED_HOSTS=replace-with-comma-separated-image-hosts
